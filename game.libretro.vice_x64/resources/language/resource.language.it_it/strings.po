msgctxt "#30617"
msgid "Press the mapped key to toggle the statusbar."
msgstr "Premi il tasto mappato per attivare/disattivare la barra di stato."

msgctxt "#30618"
msgid ""
"Press the mapped key to switch joyports 1 & 2.\n"
"Switching disables 'RetroPad Port' option until core restart."
msgstr ""
"Premi il tasto mappato per scambiare le joyport 1 e 2.\n"
"Lo scambio disabilita l'opzione 'Porta RetroPad' fino al riavvio del core."

msgctxt "#30619"
msgid "Press the mapped key to toggle turbo fire."
msgstr "Premi il tasto mappato per attivare/disattivare il fuoco rapido."

msgctxt "#30620"
msgid "Press the mapped key to create/insert/eject a save disk."
msgstr "Premi il tasto mappato per creare/inserire/espellere un disco di salvataggio."

msgctxt "#30621"
msgid ""
"Press the mapped key to toggle aspect ratio.\n"
"Toggling disables 'Pixel Aspect Ratio' option until core restart."
msgstr ""
"Premi il tasto mappato per cambiare il rapporto d'aspetto.\n"
"Il cambio disabilita l'opzione 'Rapporto d'aspetto pixel' fino al riavvio del core."

msgctxt "#30622"
msgid "Press the mapped key to toggle crop."
msgstr "Premi il tasto mappato per attivare/disattivare il ritaglio."

msgctxt "#30623"
msgid "Press the mapped key to toggle Datasette hotkeys."
msgstr "Premi il tasto mappato per attivare/disattivare i tasti rapidi del Datasette."

msgctxt "#30624"
msgid "Press play on tape."
msgstr "Premi play sulla cassetta."

msgctxt "#30625"
msgid "Press stop on tape."
msgstr "Premi stop sulla cassetta."

msgctxt "#30626"
msgid "Press rewind on tape."
msgstr "Premi riavvolgimento sulla cassetta."

msgctxt "#30627"
msgid "Press fast forward on tape."
msgstr "Premi avanzamento rapido sulla cassetta."

msgctxt "#30628"
msgid "Reset tape to beginning."
msgstr "Riporta la cassetta all'inizio."

msgctxt "#30629"
msgid "Press the mapped key to trigger the selected 'Reset Type'."
msgstr "Premi il tasto mappato per attivare il 'Tipo di reset' selezionato."

msgctxt "#30630"
msgid "Hold the mapped key for warp mode."
msgstr "Tieni premuto il tasto mappato per la modalità warp."

