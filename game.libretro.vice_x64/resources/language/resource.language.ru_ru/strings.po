msgctxt "#30676"
msgid ""
"- 'Full': Joyports + Messages + LEDs\n"
"- 'Basic': Messages + LEDs\n"
"- 'Minimal': LED colors only"
msgstr ""
"- «Полная»: порты джойстика + сообщения + светодиоды\n"
"- «Базовая»: сообщения + светодиоды\n"
"- «Минимальная»: только цвета светодиодов"

